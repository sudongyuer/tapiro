{
  "name": "tapiro",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.24",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.29",
    "expo-apple-authentication": "~57.0.2",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.4.4",
    "react": "19.2.3",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "~19.2.2",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "lint": "node -e \"const [a,b,c]=process.versions.node.split('.').map(Number);if(a<20||(a===20&&(b<19||(b===19&&c<4)))){console.error('expo lint needs Node >=20.19.4, found '+process.versions.node);process.exit(1)}\" && expo lint",
    "typecheck": "tsc --noEmit",
    "check-specs": "node scripts/check-specs.mjs --dir docs/specs",
    "check-story-map": "node scripts/check-story-map.mjs",
    "test": "bun test",
    "design-check": "node scripts/design-check.mjs",
    "verify:build": "verification/ui/build.sh",
    "verify:ui": "python3 verification/ui/run.py",
    "verify:smoke": "python3 verification/ui/run.py --smoke",
    "verify:full": "python3 verification/ui/run.py",
    "verify:clean": "rm -rf .verify",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" app.json package.json",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "fn:serve": "supabase functions serve",
    "test:stack": "bun test ./supabase/functions/tests/*.integration.ts ./src/features/account/*.integration.ts ./src/features/payee/*.integration.ts"
  },
  "private": true
}
