{
  "name": "tapiro",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-media-library": "~58.0.13",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "i18next": "^26.4.4",
    "react": "19.3.0",
    "react-i18next": "^17.0.16",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "~19.3.0",
    "eslint": "^9",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "dev:two": "bun scripts/dev-two.ts",
    "lint:changed": "node scripts/lint-changed.mjs",
    "lint": "node -e \"const [a,b,c]=process.versions.node.split('.').map(Number);if(a<20||(a===20&&(b<19||(b===19&&c<4)))){console.error('expo lint needs Node >=20.19.4, found '+process.versions.node);process.exit(1)}\" && expo lint",
    "typecheck": "tsc --noEmit",
    "check-specs": "node scripts/check-specs.mjs --dir docs/specs",
    "check-story-map": "node scripts/check-story-map.mjs",
    "check:size": "node scripts/check-file-size.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test": "bun test",
    "test:kit-swift": "bash scripts/test-kit-swift.sh",
    "design-check": "node scripts/design-check.mjs",
    "verify:build": "verification/ui/build.sh",
    "verify:ui": "python3 verification/ui/run.py",
    "verify:smoke": "python3 verification/ui/run.py --smoke",
    "verify:full": "python3 verification/ui/run.py",
    "verify:clean": "rm -rf .verify",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" app.json package.json",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "ai:budget": "bun scripts/ai-budget-measure.ts",
    "db:test-accounts": "bun scripts/db-test-accounts.ts",
    "fn:serve": "supabase functions serve --env-file supabase/functions/local.env",
    "test:deno": "deno test --no-check --no-lock --node-modules-dir=none --allow-env --import-map=supabase/functions/tests/deno-import-map.json supabase/functions/ai-draft/handler.test.ts supabase/functions/ai-draft/ask.test.ts supabase/functions/ai-draft/transcribe.test.ts supabase/functions/ai-draft/budget.test.ts supabase/functions/ai-draft/store.test.ts supabase/functions/ai-draft/modelStudio.test.ts supabase/functions/ai-draft/providerConfig.test.ts supabase/functions/ai-draft/modelStudioAsr.test.ts supabase/functions/_shared/iap/config.test.ts supabase/functions/_shared/iap/apple.deno-test.ts supabase/functions/iap-verify/handler.test.ts supabase/functions/iap-notify/handler.test.ts",
    "test:stack": "bun test ./supabase/functions/tests/*.integration.ts ./src/features/account/*.integration.ts ./src/features/payee/*.integration.ts ./src/features/payment/*.integration.ts ./src/features/bounty/post/*.integration.ts"
  },
  "private": true
}
