# Local Supabase (`supabase status`); the anon key is the CLI's public demo key, not a secret.
# Copy to .env.local. The Simulator reaches 127.0.0.1 on the Mac; a device needs the Mac's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Google Sign-In OAuth client IDs from Google Cloud (public identifiers, not secrets). Leave unset to build without
# Google sign-in. The iOS client also sets the reversed-client-ID URL scheme at prebuild.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
