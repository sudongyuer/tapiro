{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "tapiro-kit": ["./modules/tapiro-kit/index.tsx"]
    },
    "types": ["bun"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    "supabase/functions/*/index.ts",
    "supabase/functions/tests/deno-bun-test.ts",
    "supabase/functions/_shared/iap/apple.ts",
    "supabase/functions/_shared/iap/runtime.ts",
    "supabase/functions/**/*.deno-test.ts"
  ]
}
