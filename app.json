{
  "expo": {
    "name": "Tapiro",
    "slug": "tapiro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tapiro",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios"],
    "ios": {
      "icon": "./assets/expo.icon",
      "deploymentTarget": "26.0",
      "bundleIdentifier": "app.tapiro",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": false,
          "supportedLocales": {
            "ios": ["zh-Hans", "en", "ms"]
          }
        }
      ],
      ["expo-secure-store", { "faceIDPermission": false }],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Scan a receive QR code shown on another screen. Tapiro reads the code only and saves no photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a receive QR code shown on another screen. Tapiro reads the code only and saves no photo.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Save a payee's receive QR code to Photos so you can scan it from your wallet app. Tapiro only adds this one image.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "./plugins/withoutAppleSignInEntitlement"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "zh-Hans": "./src/lib/i18n/native/zh-Hans.json",
      "en": "./src/lib/i18n/native/en.json",
      "ms": "./src/lib/i18n/native/ms.json"
    }
  }
}
